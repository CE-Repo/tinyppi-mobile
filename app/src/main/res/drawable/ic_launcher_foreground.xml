<?xml version="1.0" encoding="utf-8"?>
<!--
    What the add-on is, drawn: a picture with a small panel of readings over one
    corner of it. That is TinyPPI - an overlay on a running video - and it is
    the one thing about it that is recognisable at the size of a launcher icon.

    Only the middle 72 of the 108x108 adaptive canvas is ever shown, so the
    screen is sized against that rather than against the canvas; a round mask
    would otherwise take its corners with it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The picture, as an outline in the accent the dashboard uses. -->
    <path
        android:pathData="M26,30 L82,30 A6,6 0 0 1 88,36 L88,72 A6,6 0 0 1 82,78 L26,78 A6,6 0 0 1 20,72 L20,36 A6,6 0 0 1 26,30 Z"
        android:strokeWidth="5"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="30"
                android:endX="88"
                android:endY="78"
                android:type="linear">
                <item android:offset="0" android:color="#FF4FC3F7" />
                <item android:offset="1" android:color="#FF3B82F6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Something playing inside it, kept faint: the readings are the subject. -->
    <path
        android:fillColor="#4FC3F7"
        android:fillAlpha="0.32"
        android:pathData="M64,38 L78,45.5 L64,53 Z" />

    <!-- The overlay panel itself, over the lower-left corner as it is drawn. -->
    <path
        android:fillColor="#F2F6FA"
        android:pathData="M30,50 L58,50 A3,3 0 0 1 61,53 L61,68 A3,3 0 0 1 58,71 L30,71 A3,3 0 0 1 27,68 L27,53 A3,3 0 0 1 30,50 Z" />

    <!-- Three readings on it, longest first, the way a panel of them reads. -->
    <path
        android:fillColor="#0B0F14"
        android:pathData="M32.5,55 L55.5,55 A1.5,1.5 0 0 1 55.5,58 L32.5,58 A1.5,1.5 0 0 1 32.5,55 Z" />
    <path
        android:fillColor="#0B0F14"
        android:pathData="M32.5,59.5 L49.5,59.5 A1.5,1.5 0 0 1 49.5,62.5 L32.5,62.5 A1.5,1.5 0 0 1 32.5,59.5 Z" />
    <path
        android:fillColor="#3B82F6"
        android:pathData="M32.5,64 L44.5,64 A1.5,1.5 0 0 1 44.5,67 L32.5,67 A1.5,1.5 0 0 1 32.5,64 Z" />
</vector>
