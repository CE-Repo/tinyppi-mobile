<?xml version="1.0" encoding="utf-8"?>
<!--
    The two lines the history screen draws: the scene's peak luminance, bright,
    and its average, dimmed, underneath. That pair is what TinyPPI is for, and
    the distance between them is the reading - so it is the one thing about the
    add-on worth putting on a launcher.

    No frame around them, because there already is one. An adaptive icon's
    background layer fills the whole canvas and the launcher's mask cuts the
    shape out of it, so the dark ground *is* the picture - drawing a second
    frame inside it would only be a screen within a screen, and would cost the
    room these two lines need.

    Everything sits within a radius of 33 of the centre, which is the part every
    mask keeps: the circle crops hardest, at 36, and the strokes end well inside
    it. Nothing here is thinner than 4 of the 108, so at a 40dp launcher size the
    finest stroke is still a pixel and a half.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        The average. Below the peak at every sample, which is not a drawing
        decision - an average cannot exceed the maximum it is taken from.
    -->
    <path
        android:pathData="M26,70 L40,67 L52,61 L66,65 L82,60"
        android:strokeColor="#2C6A8C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The peak, with the one spike a graded scene actually produces. -->
    <path
        android:pathData="M26,64 L38,59 L50,31 L58,53 L70,43 L82,58"
        android:strokeColor="#7DD8FF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
