<?xml version="1.0" encoding="utf-8"?>
<!--
    The same two lines for the themed icon a launcher tints itself.

    Identical geometry rather than a redrawn silhouette, because nothing here
    depended on colour to be read: the two lines were told apart by weight and
    position, and the one thing colour did carry - which of them is the peak -
    survives as opacity. A themed icon is a single colour plus alpha, which is
    exactly what this design already was.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M26,70 L40,67 L52,61 L66,65 L82,60"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.42"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M26,64 L38,59 L50,31 L58,53 L70,43 L82,58"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
